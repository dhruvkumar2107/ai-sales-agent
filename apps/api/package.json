{
  "name": "@axo/api",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch --env-file-if-exists=../../.env src/index.ts",
    "worker": "tsx --env-file-if-exists=../../.env src/worker.ts",
    "build": "tsup",
    "start": "node dist/index.js",
    "start:worker": "node dist/worker.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "seed": "tsx --env-file-if-exists=../../.env scripts/seed.ts",
    "simulate": "tsx --env-file-if-exists=../../.env src/simulator/cli.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^1.3.0",
    "@axo/shared": "workspace:*",
    "@fastify/cors": "^9.0.1",
    "@fastify/formbody": "^7.4.0",
    "@fastify/multipart": "^8.3.0",
    "@fastify/rate-limit": "^9.1.0",
    "bullmq": "^5.21.2",
    "csv-parse": "^5.5.6",
    "deepgram": "^1.0.3",
    "fastify": "^4.28.1",
    "firebase-admin": "^12.7.0",
    "ioredis": "^5.4.1",
    "pg": "^8.23.1",
    "pino": "^9.5.0",
    "twilio": "^6.2.0",
    "ws": "^8.18.0",
    "zod": "^3.23.8",
    "zod-to-json-schema": "^3.23.5"
  },
  "devDependencies": {
    "@types/node": "^20.16.0",
    "@types/pg": "^8.23.1",
    "@types/ws": "^8.5.12",
    "pino-pretty": "^11.3.0",
    "tsup": "^8.3.5",
    "tsx": "^4.19.2",
    "typescript": "^5.6.3",
    "vitest": "^2.1.4"
  }
}
