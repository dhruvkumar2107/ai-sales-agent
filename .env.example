# =============================================================================
# AXO Voice Auto - environment configuration
# Copy to .env and fill in. Everything has a safe local default, so the app runs
# with zero keys (mock providers + in-memory data). Add keys to go live.
# =============================================================================

# ---------- Core ----------
NODE_ENV=development
PORT=4000
LOG_LEVEL=info
# Public HTTPS URL of the API that Twilio/Exotel can reach (your ngrok URL in dev). No trailing slash.
PUBLIC_BASE_URL=https://your-subdomain.ngrok-free.app
# Dashboard origin(s) allowed by CORS, comma separated
WEB_ORIGIN=http://localhost:3000

# ---------- Data, queue, auth ----------
# memory = JSON file at MEMORY_DB_FILE (dev/demo) | firestore = Firebase Firestore (production)
DATA_BACKEND=memory
MEMORY_DB_FILE=.data/db.json
# memory = jobs run inside the API process | bullmq = Redis + separate worker (production)
QUEUE_BACKEND=memory
REDIS_URL=redis://localhost:6379
# dev = no login, you are the owner of DEV_ORG_ID | firebase = Firebase Auth ID tokens
AUTH_MODE=dev
DEV_ORG_ID=demo-org

# ---------- Platform admin (you, the owner selling to dealerships) ----------
# Firebase mode: these login emails get the admin panel (/admin) and can open any dealership
SUPER_ADMIN_EMAILS=
# Admin panel key, entered once at /admin. Required in production with AUTH_MODE=dev (hosted demo).
# Local development without a key: you are the admin automatically.
ADMIN_KEY=

# Firebase Admin (service account). Either inline credentials or GOOGLE_APPLICATION_CREDENTIALS.
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
# Paste with literal \n sequences; they are converted to newlines
FIREBASE_PRIVATE_KEY=
FIREBASE_STORAGE_BUCKET=your-project.appspot.com
GOOGLE_APPLICATION_CREDENTIALS=
# Local recordings folder when not using Firebase Storage
RECORDINGS_DIR=.data/recordings

# 32 random bytes, base64. Encrypts recordings and stored API keys (AES-256-GCM). REQUIRED in production.
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
ENCRYPTION_KEY=

# ---------- Provider selection ----------
TELEPHONY_PROVIDER=twilio      # twilio | exotel | mock
STT_PROVIDER=deepgram          # deepgram | sarvam | mock   (sarvam recommended for Kannada)
TTS_PROVIDER=elevenlabs        # elevenlabs | sarvam | mock
LLM_PROVIDER=anthropic         # anthropic | gemini | mock
MESSAGING_PROVIDER=log         # meta | twilio | exotel | log  (meta = WhatsApp Cloud API; SMS then goes via Twilio if set)
# A provider without credentials automatically falls back to its mock.

# ---------- Meta WhatsApp Cloud API (MESSAGING_PROVIDER=meta) ----------
# Platform default number; each dealership can get its own number id + token in the admin panel.
META_WA_TOKEN=
META_WA_PHONE_NUMBER_ID=
# Webhook: GET/POST https://<api>/webhooks/whatsapp  (verify token below, signature via app secret)
META_WA_VERIFY_TOKEN=axo-verify
META_APP_SECRET=
# Dealership that receives messages sent to the platform default number
WHATSAPP_DEFAULT_ORG_ID=

# ---------- Twilio (voice, SMS, WhatsApp) ----------
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=+1XXXXXXXXXX
TWILIO_WHATSAPP_FROM=+14155238886

# ---------- Exotel (India) ----------
EXOTEL_SID=
EXOTEL_API_KEY=
EXOTEL_API_TOKEN=
EXOTEL_SUBDOMAIN=api.exotel.com
EXOTEL_CALLER_ID=
# Flow (App Bazaar) URL: http://my.exotel.com/<sid>/exoml/start_voice/<flow_id>
EXOTEL_FLOW_URL=
# Shared secret appended as ?secret= to Exotel webhook/stream URLs
EXOTEL_WEBHOOK_SECRET=

# ---------- Speech-to-text ----------
DEEPGRAM_API_KEY=
DEEPGRAM_MODEL=nova-3
SARVAM_API_KEY=
SARVAM_STT_MODEL=saarika:v2.5

# ---------- Text-to-speech ----------
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=21m00Tcm4TlvDq8ikWAM
ELEVENLABS_MODEL=eleven_flash_v2_5
SARVAM_TTS_MODEL=bulbul:v2
SARVAM_TTS_SPEAKER=anushka

# ---------- LLM (Anthropic Claude) ----------
ANTHROPIC_API_KEY=
LLM_MODEL=claude-opus-5-5
# low keeps spoken replies fast; raise for harder reasoning
LLM_EFFORT=low
# Server-side refusal fallback for Opus 5.5 / Sonnet 5.5
LLM_FALLBACKS=true

# ---------- LLM (Google Gemini, with LLM_PROVIDER=gemini) ----------
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.6-flash
# Tried in order when the primary model is overloaded (503/429) or slow
GEMINI_FALLBACK_MODELS=gemini-3.5-flash-lite,gemini-3.8-flash,gemini-flash-latest

# ---------- Google Calendar (optional) ----------
GOOGLE_CALENDAR_SA_EMAIL=
GOOGLE_CALENDAR_SA_KEY=

# ---------- Webhooks & compliance ----------
# Default HMAC secret for /webhooks/* when a dealership hasn't set its own
LEAD_WEBHOOK_SECRET=change-me
# Local testing only: accept unsigned webhooks
SKIP_SIGNATURE_VALIDATION=false

# ---------- Voice tuning ----------
SILENCE_REPROMPT_MS=6000
MAX_REPROMPTS=2
TOOL_TIMEOUT_MS=4000
MAX_CALL_SECONDS=900

# ---------- Cost model (INR) ----------
COST_TELEPHONY_PER_MIN=0.6
COST_STT_PER_MIN=0.5
COST_TTS_PER_1K_CHARS=2.0
COST_LLM_INPUT_PER_MTOK=336
COST_LLM_OUTPUT_PER_MTOK=1680
COST_MESSAGE=0.35

# ---------- Dashboard (Next.js, build-time) ----------
NEXT_PUBLIC_API_URL=http://localhost:4000
NEXT_PUBLIC_AUTH_MODE=dev
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=
